
#include <stdio.h>

int main() {
    int d[7], i, p1, p2, p4;

    printf("Enter 4 data bits: ");
    scanf("%d%d%d%d", &d[2], &d[4], &d[5], &d[6]);

    d[1] = d[2] ^ d[4] ^ d[6];
    d[3] = d[2] ^ d[5] ^ d[6];
    d[7] = d[4] ^ d[5] ^ d[6];

    printf("Hamming Code: ");
    for(i = 1; i <= 7; i++)
        printf("%d", d[i]);

    return 0;
}
